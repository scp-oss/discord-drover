<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DroverSwitch</RootNamespace>
    <AssemblyName>DroverSwitch</AssemblyName>
    <!-- Mini helper app, lives in the tray; it never needs admin rights. -->
    <StartupObject>DroverSwitch.App</StartupObject>
    <!-- Bump this alongside the GitHub release tag (drover-switch-vX.Y.Z) - keep them in sync so
         the exe's own file properties (right-click - Properties - Details) always match the
         release it came from. -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fluent/Win11-styled controls, Mica backdrop, light/dark theme synced with the OS. -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <!-- Native WPF tray icon with a custom popup instead of a WinForms NotifyIcon. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fetched by the CI workflow from the upstream hdrover/discord-drover release before build
         (see .github/workflows/drover-switch-build.yml) so DroverInstaller can deploy it on first
         run. Condition means a local build without that fetch step still compiles fine - auto-
         install just silently does nothing until the resource is actually present. -->
    <EmbeddedResource Include="Resources\version.dll" Condition="Exists('Resources\version.dll')" />
    <EmbeddedResource Include="Resources\drover-packet.bin" Condition="Exists('Resources\drover-packet.bin')" />
  </ItemGroup>

</Project>
