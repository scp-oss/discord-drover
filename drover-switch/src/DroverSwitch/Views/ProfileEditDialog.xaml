<ui:FluentWindow
    x:Class="DroverSwitch.Views.ProfileEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Конфиг прокси"
    Width="380"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True">
    <StackPanel Margin="20,0,20,16">
        <ui:TitleBar Title="Конфиг прокси" Margin="-20,0,-20,12" />

        <TextBlock Text="Название" Margin="0,0,0,4" />
        <ui:TextBox x:Name="NameBox" PlaceholderText="Например: Proxy EU" Margin="0,0,0,12" />

        <TextBlock Text="Адрес прокси" Margin="0,0,0,4" />
        <ui:TextBox x:Name="UrlBox"
                    PlaceholderText="protocol://ip_или_domen:port"
                    Margin="0,0,0,4" />

        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,0,0,16"
                   Text="Формат: protocol://host:port или protocol://login:password@host:port, где protocol — http или socks5, host — IP-адрес или домен (авторизация поддерживается только для http). Примеры: http://1.2.3.4:8080, socks5://proxy.example.com:1080, http://user:pass@1.2.3.4:8080. Пустое поле — прямое соединение без прокси." />

        <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12" Margin="0,0,0,8"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Отмена" Click="OnCancelClick" Margin="0,0,8,0" />
            <ui:Button Content="Сохранить" Appearance="Primary" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
