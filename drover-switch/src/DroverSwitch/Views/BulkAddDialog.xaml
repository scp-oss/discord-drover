<ui:FluentWindow
    x:Class="DroverSwitch.Views.BulkAddDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Добавить конфиги"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    Background="#0D1320">

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#262F47" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E97AC" />
    </ui:FluentWindow.Resources>

    <Border Background="#0D1320" BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Добавить конфиги" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

            <TextBlock Text="По одному прокси на строку" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="ListBox" AcceptsReturn="True" TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" Height="140"
                        PlaceholderText="dr-eu http://203.0.113.10:3128&#10;socks5://proxy.example.com:1080"
                        Margin="0,0,0,4" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Opacity="0.85" Margin="0,0,0,16"
                       Text="Строка: [имя] protocol://host:port (имя необязательно, через пробел - если не указано, подставится host:port). protocol - http или socks5, авторизация http://login:password@host:port поддерживается только для http. Можно вставить сразу много строк." />

            <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Отмена" MinHeight="0" Padding="14,8" Click="OnCancelClick" Margin="0,0,8,0" />
                <ui:Button Content="Добавить" Appearance="Primary" MinHeight="0" Padding="14,8"
                           Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>
