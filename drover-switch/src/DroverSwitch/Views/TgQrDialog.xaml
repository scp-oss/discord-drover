<ui:FluentWindow
    x:Class="DroverSwitch.Views.TgQrDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Telegram на телефоне"
    Width="360"
    SizeToContent="Height"
    MinHeight="0"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    Background="#0D1320">

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#262F47" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E97AC" />
    </ui:FluentWindow.Resources>

    <Border Background="#0D1320" BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Telegram на телефоне" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
            <TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                       Text="Отсканируйте QR камерой телефона, который подключён к той же Wi-Fi сети, что и этот компьютер, — Telegram предложит добавить прокси." />
            <StackPanel x:Name="IpPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="Сеть, в которой телефон:" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox x:Name="IpBox" DisplayMemberPath="Display" SelectionChanged="OnIpChanged" FontSize="12" />
            </StackPanel>
            <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBox x:Name="LinkBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"
                     Foreground="{StaticResource TextPrimaryBrush}" Background="#161F33" BorderThickness="0" Padding="8" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                       Text="Если телефон не подключается: разрешите tg-ws-proxy в брандмауэре Windows (частные сети) — Windows спросит об этом при первом включении." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Копировать ссылку" MinHeight="0" Padding="14,8" Click="OnCopyClick" Margin="0,0,8,0" />
                <ui:Button Content="Закрыть" Appearance="Primary" MinHeight="0" Padding="14,8" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>
