<ui:FluentWindow
    x:Class="DroverSwitch.Views.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DroverSwitch.ViewModels"
    xmlns:views="clr-namespace:DroverSwitch.Views"
    Title="Discord Drover"
    Width="296"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    Deactivated="TrayPopup_Deactivated"
    x:Name="RootWindow">

    <ui:FluentWindow.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:ActiveToAppearanceConverter x:Key="ActiveToAppearance" />
    </ui:FluentWindow.Resources>

    <Border Padding="12" CornerRadius="8">
        <StackPanel>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Discord Drover" FontSize="14" FontWeight="SemiBold" />
                <ui:ProgressRing Grid.Column="1" Width="14" Height="14"
                                  Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <TextBlock Text="{Binding StatusHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                        <ui:Button HorizontalContentAlignment="Stretch" Margin="0,1" Padding="6,5"
                                   Appearance="{Binding IsActive, Converter={StaticResource ActiveToAppearance}}"
                                   Command="{Binding DataContext.ActivateProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.ContextMenu>
                                <!-- A ContextMenu opens in its own Popup, outside the main visual tree, so
                                     RelativeSource/AncestorType can't reach the window from here - ElementName
                                     still works because it resolves through the logical NameScope instead. -->
                                <ContextMenu>
                                    <MenuItem Header="Изменить"
                                              Command="{Binding DataContext.EditProfileCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Удалить"
                                              Command="{Binding DataContext.RemoveProfileCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LatencyText}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{Binding StatusBrush}"
                                           MinWidth="52" TextAlignment="Right" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" />
                                    <TextBlock Text="{Binding MaskedUrl}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark24" FontSize="14"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,2,0,8" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Автопереключение при недоступности" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="12" Margin="0,0,8,0" />
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoModeEnabled}" />
            </Grid>

            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="8" CornerRadius="6"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsDiscordRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Discord сейчас запущен." FontSize="12" TextWrapping="Wrap" />
                    <ui:Button Content="Перезапустить Discord" Command="{Binding RestartDiscordCommand}"
                               Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Добавить" Icon="{ui:SymbolIcon Add24}" Padding="0,5"
                           Command="{Binding AddProfileCommand}" Margin="0,0,4,0" />
                <ui:Button Grid.Column="1" Content="Проверить" Padding="0,5" Command="{Binding RefreshNowCommand}"
                           Margin="4,0,4,0" />
                <ui:Button Grid.Column="2" Content="Выход" Padding="0,5" Command="{Binding ExitCommand}"
                           Margin="4,0,0,0" />
            </Grid>
        </StackPanel>
    </Border>
</ui:FluentWindow>
