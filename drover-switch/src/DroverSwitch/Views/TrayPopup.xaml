<ui:FluentWindow
    x:Class="DroverSwitch.Views.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DroverSwitch.ViewModels"
    xmlns:views="clr-namespace:DroverSwitch.Views"
    Title="Discord Drover"
    Width="380"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    Background="#0D1320"
    Deactivated="TrayPopup_Deactivated"
    SizeChanged="TrayPopup_SizeChanged"
    x:Name="RootWindow">

    <ui:FluentWindow.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:ActiveToBackgroundConverter x:Key="ActiveToBackground" />
        <views:ActiveToBorderBrushConverter x:Key="ActiveToBorderBrush" />
        <views:ActiveToGlowEffectConverter x:Key="ActiveToGlow" />
        <views:ActiveToAccentOrTransparentConverter x:Key="ActiveToAccent" />
        <views:BoolToDotBrushConverter x:Key="BoolToDotBrush" />

        <!-- Design tokens: one place for every color/radius this page uses. -->
        <SolidColorBrush x:Key="WindowBg" Color="#0D1320" />
        <SolidColorBrush x:Key="WindowBorder" Color="#232B40" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161F33" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#262F47" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E97AC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B8CFF" Offset="0" />
            <GradientStop Color="#2954C8" Offset="1" />
        </LinearGradientBrush>

        <!-- ICONS: SVG path data, 24x24 viewBox, drawn as strokes (stroke-width 2, round caps/joins). -->
        <Geometry x:Key="IcoClose">M6,6 L18,18 M18,6 L6,18</Geometry>
        <Geometry x:Key="IcoPlus">M12,5 L12,19 M5,12 L19,12</Geometry>
        <Geometry x:Key="IcoRefresh">M20,12 A8,8 0 1 1 17.66,6.34 M20,4 L20,9 L15,9</Geometry>
        <Geometry x:Key="IcoTrash">M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,11 L10,16 M14,11 L14,16</Geometry>
        <Geometry x:Key="IcoQr">M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L16,14 L16,16 L14,16 Z M18,18 L20,18 L20,20 L18,20 Z M18,14 L20,14 M14,19 L15,19</Geometry>
        <Geometry x:Key="IcoLink">M10,14 L14,10 M8.5,12.5 L6.5,14.5 A3.5,3.5 0 0 0 11.5,19.5 L13.5,17.5 M15.5,11.5 L17.5,9.5 A3.5,3.5 0 0 0 12.5,4.5 L10.5,6.5</Geometry>
        <Geometry x:Key="IcoPower">M12,3 L12,12 M7,6.3 A8,8 0 1 0 17,6.3</Geometry>
        <Geometry x:Key="IcoPlay">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="IcoTelegram">M21,4 L3,11.5 L9.5,13.5 L11.5,20 L14.5,16 L19,19.5 Z M9.5,13.5 L21,4</Geometry>
        <Geometry x:Key="IcoDiscord">M7,7 Q12,5.5 17,7 Q20,11 20,16 Q18,18 15.5,18.5 L14.5,16.5 Q12,17.2 9.5,16.5 L8.5,18.5 Q6,18 4,16 Q4,11 7,7 Z M9.5,12 L9.5,12.5 M14.5,12 L14.5,12.5</Geometry>

        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <!-- Icon-only buttons on our own template: WPF-UI's Transparent/Standard appearances fell
             back to light-theme fills here, so the colors are set explicitly. -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Tag" Value="#26FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <Border x:Name="hl" Background="#FFFFFF" CornerRadius="8" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hl" Property="Opacity" Value="0.10" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hl" Property="Opacity" Value="0.20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoxBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#1F2A44" />
            <Setter Property="BorderBrush" Value="#2F3B5A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BoxBtnPrimary" TargetType="Button" BasedOn="{StaticResource BoxBtn}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="#4F7FF0" />
        </Style>
    </ui:FluentWindow.Resources>

    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource WindowBorder}"
            BorderThickness="1" CornerRadius="14" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <!-- Rubber layout: header/banner on top and the settings + Telegram/Discord boxes at the
             bottom keep their size; the proxy list (row 2, *) takes whatever is left and scrolls.
             The window's MaxHeight is set to the screen work area in TrayPopup.xaml.cs, so with a
             long list the window stops growing and only the list shrinks. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Top">
                    <Ellipse Width="14" Height="14" Fill="White" Opacity="0.9"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Discord Drover" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusHint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding HasActiveProfile, Converter={StaticResource BoolToDotBrush}}" />
                        <TextBlock Text="{Binding ActiveProfileDisplay}" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,-4,0">
                    <Grid Width="30" Height="30">
                        <Button Style="{StaticResource IconBtn}" Command="{Binding RefreshNowCommand}" ToolTip="Проверить прокси"
                                   Visibility="{Binding IsNotChecking, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoRefresh}" /></Canvas></Viewbox>
                        </Button>
                        <ui:ProgressRing Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Button Style="{StaticResource IconBtn}" Command="{Binding AddProfileCommand}" ToolTip="Добавить прокси">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlus}" /></Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Command="{Binding ExitCommand}" ToolTip="Выход">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}" /></Canvas></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- UPDATE BANNER - only shown for an update found while the app was already running
                 (the startup check installs that case automatically, no banner needed for it). -->
            <ui:Button Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="0"
                       Padding="12,10" Margin="0,0,0,10" CornerRadius="10"
                       Background="{StaticResource AccentGradientBrush}"
                       Command="{Binding ApplyUpdateCommand}"
                       Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" FontSize="12"
                               FontWeight="Medium" Foreground="White" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowSync24" FontSize="16"
                                   Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </ui:Button>

            <!-- PROXY LIST: scrolls on its own; TrayPopup.xaml.cs caps its height so the whole popup
                 (and the buttons below it) always fits the screen's work area. -->
            <ScrollViewer x:Name="ProfilesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                          Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                        <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Margin="0,3" Padding="12,8"
                                   CornerRadius="10" BorderThickness="2"
                                   Background="{Binding IsActive, Converter={StaticResource ActiveToBackground}}"
                                   BorderBrush="{Binding IsActive, Converter={StaticResource ActiveToBorderBrush}}"
                                   Effect="{Binding IsActive, Converter={StaticResource ActiveToGlow}}"
                                   Command="{Binding DataContext.ActivateProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.ContextMenu>
                                <!-- A ContextMenu's DataContext does inherit across the Popup
                                     boundary from its PlacementTarget (this button), so Edit/Remove
                                     live directly on the row's own ProfileItemViewModel - no
                                     ElementName/RelativeSource needed (those did not resolve
                                     reliably from here in practice). -->
                                <ContextMenu>
                                    <MenuItem Header="Изменить" Command="{Binding EditCommand}" />
                                    <MenuItem Header="Удалить" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- latency: tiny ascending signal bars + the ms value, both colored by status -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Height="12" VerticalAlignment="Center">
                                        <Border Width="3" Height="5" CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{Binding StatusBrush}" Margin="0,0,2,0" />
                                        <Border Width="3" Height="8" CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{Binding StatusBrush}" Margin="0,0,2,0" />
                                        <Border Width="3" Height="12" CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{Binding StatusBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatencyText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding MaskedUrl}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="26" Height="26" Margin="6,0,0,0"
                                           Command="{Binding RemoveCommand}" ToolTip="Удалить прокси" Opacity="0.6">
                                    <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}" Stroke="{StaticResource TextSecondaryBrush}" /></Canvas></Viewbox>
                                </Button>

                            </Grid>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- AUTO SWITCH -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,2,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Polygon Points="6,0 0,9 4,9 3,16 10,6 6,6" Width="10" Height="16" Stretch="Uniform"
                                 Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Автопереключение при недоступности" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoModeEnabled}" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- AUTOSTART -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Запускать вместе с Windows" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- TELEGRAM + DISCORD: two boxes, two icon buttons each (tooltips name the action) -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoTelegram}" Stroke="#2AABEE" /></Canvas></Viewbox>
                            <TextBlock Grid.Column="1" Text="Telegram" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding TgWsEnabled}" />
                        </Grid>
                        <TextBlock Text="{Binding TgWsStatusText}" ToolTip="{Binding TgWsStatusText}" FontSize="11" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BoxBtnPrimary}" Command="{Binding AddToTelegramCommand}"
                                    IsEnabled="{Binding TgWsEnabled}" ToolTip="Добавить прокси в Telegram Desktop">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlus}" Stroke="White" /></Canvas></Viewbox>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource BoxBtn}" Command="{Binding ShowTgQrCommand}"
                                    IsEnabled="{Binding TgWsEnabled}" ToolTip="QR-код для телефона в той же Wi-Fi сети">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoQr}" /></Canvas></Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoDiscord}" Stroke="#5865F2" /></Canvas></Viewbox>
                            <TextBlock Grid.Column="1" Text="Discord" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding IsDiscordRunning, Converter={StaticResource BoolToDotBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding DiscordStatusText}" ToolTip="{Binding DiscordStatusText}" FontSize="11" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BoxBtnPrimary}" Command="{Binding RestartDiscordCommand}"
                                    ToolTip="Перезапустить Discord"
                                    Visibility="{Binding IsDiscordRunning, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoRefresh}" Stroke="White" /></Canvas></Viewbox>
                            </Button>
                            <Button Grid.Column="0" Style="{StaticResource BoxBtnPrimary}" Command="{Binding StartDiscordCommand}"
                                    ToolTip="Запустить Discord"
                                    Visibility="{Binding IsDiscordNotRunning, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlay}" Stroke="White" /></Canvas></Viewbox>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource BoxBtn}" Command="{Binding CloseDiscordCommand}"
                                    IsEnabled="{Binding IsDiscordRunning}" ToolTip="Закрыть Discord">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPower}" /></Canvas></Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
