<ui:FluentWindow
    x:Class="DroverSwitch.Views.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DroverSwitch.ViewModels"
    xmlns:views="clr-namespace:DroverSwitch.Views"
    Title="Discord Drover"
    Width="380"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    Background="#0D1320"
    Deactivated="TrayPopup_Deactivated"
    SizeChanged="TrayPopup_SizeChanged"
    x:Name="RootWindow">

    <ui:FluentWindow.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:ActiveToBackgroundConverter x:Key="ActiveToBackground" />
        <views:ActiveToBorderBrushConverter x:Key="ActiveToBorderBrush" />
        <views:ActiveToGlowEffectConverter x:Key="ActiveToGlow" />
        <views:ActiveToAccentOrTransparentConverter x:Key="ActiveToAccent" />
        <views:BoolToDotBrushConverter x:Key="BoolToDotBrush" />

        <!-- Design tokens: one place for every color/radius this page uses. -->
        <SolidColorBrush x:Key="WindowBg" Color="#0D1320" />
        <SolidColorBrush x:Key="WindowBorder" Color="#232B40" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161F33" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#262F47" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E97AC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B8CFF" Offset="0" />
            <GradientStop Color="#2954C8" Offset="1" />
        </LinearGradientBrush>
    </ui:FluentWindow.Resources>

    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource WindowBorder}"
            BorderThickness="1" CornerRadius="14" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>

            <!-- HEADER -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Top">
                    <Ellipse Width="14" Height="14" Fill="White" Opacity="0.9"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Discord Drover" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusHint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding HasActiveProfile, Converter={StaticResource BoolToDotBrush}}" />
                        <TextBlock Text="{Binding ActiveProfileDisplay}" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <ui:ProgressRing Grid.Column="2" Width="16" Height="16" VerticalAlignment="Top"
                                  Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- TELEGRAM WS: toggle; when on - "QR для телефона" and "Добавить в Telegram" right at the top -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Send24" FontSize="15" Foreground="#2AABEE" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Telegram через WebSocket" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding TgWsStatusText}" FontSize="11" TextWrapping="Wrap" Margin="23,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TgWsEnabled}" Margin="10,0,0,0" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Visibility="{Binding TgWsEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" MinHeight="0" Padding="10,8" CornerRadius="8"
                                   Command="{Binding ShowTgQrCommand}" ToolTip="QR-код для телефона в той же Wi-Fi сети">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="QR для телефона" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" MinHeight="0" Padding="10,8" CornerRadius="8"
                                   Appearance="Primary" Command="{Binding AddToTelegramCommand}"
                                   ToolTip="Открыть tg://proxy — Telegram Desktop предложит добавить прокси">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Добавить в Telegram" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding TgWsEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cloudflare Worker" FontSize="11" Margin="2,0,0,4"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ui:TextBox FontSize="12" MinHeight="0" Padding="8,6" ClearButtonEnabled="False"
                                    PlaceholderText="домен.workers.dev (пусто — встроенный)"
                                    Text="{Binding TgWsWorker, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="TgWorkerBox_KeyDown"
                                    ToolTip="Через него идёт Telegram, если прямое подключение заблокировано. Можно указать свой Worker (несколько — через запятую). Очистить поле — вернуть встроенный." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- UPDATE BANNER - only shown for an update found while the app was already running
                 (the startup check installs that case automatically, no banner needed for it). -->
            <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="0"
                       Padding="12,10" Margin="0,0,0,10" CornerRadius="10"
                       Background="{StaticResource AccentGradientBrush}"
                       Command="{Binding ApplyUpdateCommand}"
                       Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" FontSize="12"
                               FontWeight="Medium" Foreground="White" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowSync24" FontSize="16"
                                   Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </ui:Button>

            <!-- PROXY LIST: scrolls on its own; TrayPopup.xaml.cs caps its height so the whole popup
                 (and the buttons below it) always fits the screen's work area. -->
            <ScrollViewer x:Name="ProfilesScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                          Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                        <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Margin="0,3" Padding="12,8"
                                   CornerRadius="10" BorderThickness="1.5"
                                   Background="{Binding IsActive, Converter={StaticResource ActiveToBackground}}"
                                   BorderBrush="{Binding IsActive, Converter={StaticResource ActiveToBorderBrush}}"
                                   Effect="{Binding IsActive, Converter={StaticResource ActiveToGlow}}"
                                   Command="{Binding DataContext.ActivateProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.ContextMenu>
                                <!-- A ContextMenu's DataContext does inherit across the Popup
                                     boundary from its PlacementTarget (this button), so Edit/Remove
                                     live directly on the row's own ProfileItemViewModel - no
                                     ElementName/RelativeSource needed (those did not resolve
                                     reliably from here in practice). -->
                                <ContextMenu>
                                    <MenuItem Header="Изменить" Command="{Binding EditCommand}" />
                                    <MenuItem Header="Удалить" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- latency: tiny ascending signal bars + the ms value, both colored by status -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Height="12" VerticalAlignment="Center">
                                        <Border Width="3" Height="5" CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{Binding StatusBrush}" Margin="0,0,2,0" />
                                        <Border Width="3" Height="8" CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{Binding StatusBrush}" Margin="0,0,2,0" />
                                        <Border Width="3" Height="12" CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{Binding StatusBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatencyText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding MaskedUrl}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>

                                <Grid Grid.Column="2" Width="20" Height="20" Margin="10,0,0,0">
                                    <Ellipse Stroke="{Binding IsActive, Converter={StaticResource ActiveToBorderBrush}}"
                                             StrokeThickness="1.5"
                                             Fill="{Binding IsActive, Converter={StaticResource ActiveToAccent}}" />
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- AUTO SWITCH -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,2,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Polygon Points="6,0 0,9 4,9 3,16 10,6 6,6" Width="10" Height="16" Stretch="Uniform"
                                 Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Автопереключение при недоступности" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoModeEnabled}" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- AUTOSTART -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Запускать вместе с Windows" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- DISCORD STATUS CARD: always visible - one "Запустить" button when Discord is
                 closed, or a "Перезапустить"/"Закрыть" pair when it's running. -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding DiscordStatusText}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                    <ui:Button Content="Запустить Discord" Appearance="Primary" MinHeight="0"
                               Command="{Binding StartDiscordCommand}"
                               Padding="12,7" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" FontWeight="Medium"
                               Visibility="{Binding IsDiscordNotRunning, Converter={StaticResource BoolToVis}}" />

                    <Grid Margin="0,8,0,0" Visibility="{Binding IsDiscordRunning, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Перезапустить" Appearance="Primary" MinHeight="0"
                                   Command="{Binding RestartDiscordCommand}"
                                   Padding="10,7" Margin="0,0,5,0" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" FontWeight="Medium" />
                        <ui:Button Grid.Column="1" Content="Закрыть" MinHeight="0"
                                   Command="{Binding CloseDiscordCommand}"
                                   Padding="10,7" Margin="5,0,0,0" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" FontWeight="Medium" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BOTTOM ACTIONS -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" Content="Добавить" Icon="{ui:SymbolIcon Add24}" MinHeight="0"
                           Padding="8,6" Command="{Binding AddProfileCommand}" Margin="0,0,5,0" />
                <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" Content="Проверить" Icon="{ui:SymbolIcon ArrowSync24}" MinHeight="0"
                           Padding="8,6" Command="{Binding RefreshNowCommand}" Margin="5,0,5,0" />
                <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Выход" Icon="{ui:SymbolIcon SignOut24}" MinHeight="0"
                           Padding="8,6" Command="{Binding ExitCommand}" Margin="5,0,0,0" />
            </Grid>
        </StackPanel>
    </Border>
</ui:FluentWindow>
