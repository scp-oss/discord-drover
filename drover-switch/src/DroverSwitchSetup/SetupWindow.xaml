<ui:FluentWindow
    x:Class="DroverSwitchSetup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:DroverSwitchSetup"
    Title="Discord Drover Setup"
    Width="340"
    SizeToContent="Height"
    MinHeight="0"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowInTaskbar="True"
    Topmost="True"
    Background="#0D1320">

    <ui:FluentWindow.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="WindowBorder" Color="#232B40" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E97AC" />
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B8CFF" Offset="0" />
            <GradientStop Color="#2954C8" Offset="1" />
        </LinearGradientBrush>
    </ui:FluentWindow.Resources>

    <Border Background="#0D1320" BorderBrush="{StaticResource WindowBorder}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                        Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.9"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="Discord Drover" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"
                        Visibility="{Binding ShowConfirmButtons, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Отмена" MinHeight="0" Padding="14,8" Click="OnCancelUpdateClick"
                           Margin="0,0,8,0" />
                <ui:Button Content="Закрыть и обновить" Appearance="Primary" MinHeight="0" Padding="14,8"
                           Click="OnConfirmUpdateClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>
